def replace_once(path: Path, old: str, new: str) -> None:
    text = path.read_text(encoding="utf-8")
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"expected one match in {path}: {old[:100]!r}; count={count}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")


def replace_between(path: Path, start: str, end: str, new: str) -> None:
    text = path.read_text(encoding="utf-8")
    if text.count(start) != 1 or text.count(end) != 1:
        raise SystemExit(
            f"replace_between anchors not exact in {path}: start={text.count(start)} end={text.count(end)}"
        )
    start_at = text.index(start)
    end_at = text.index(end, start_at)
    path.write_text(text[:start_at] + new + text[end_at:], encoding="utf-8")


def insert_before(path: Path, marker: str, block: str) -> None:
    text = path.read_text(encoding="utf-8")
    count = text.count(marker)
    if count != 1:
        raise SystemExit(f"expected one marker in {path}: {marker[:100]!r}; count={count}")
    path.write_text(text.replace(marker, block + marker, 1), encoding="utf-8")


def append(path: Path, block: str) -> None:
    text = path.read_text(encoding="utf-8")
    if block.strip() in text:
        raise SystemExit(f"block already present in {path}")
    path.write_text(text.rstrip() + "\n\n" + block.strip() + "\n", encoding="utf-8")


