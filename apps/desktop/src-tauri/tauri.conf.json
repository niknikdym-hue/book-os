{
  "productName": "BOOK OS",
  "version": "0.1.0",
  "identifier": "com.bookos.desktop",
  "mainBinaryName": "BOOK OS",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOOK OS",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "fullscreen": false,
        "center": false,
        "titleBarStyle": "visible"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
