{
  "productName": "BOOK OS",
  "version": "0.1.0",
  "identifier": "com.bookos.desktop",
  "mainBinaryName": "BOOK OS",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm prepare:bundle && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOOK OS — Author Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/book-os-core": "book-os-core"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
