{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-os.local/contracts/mystery-os/editorial_prep_agent.schema.json",
  "title": "MYSTERY OS Editorial Prep Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "authority_refs",
    "task",
    "allowed_outputs",
    "forbidden_actions",
    "source_packet_refs",
    "private_content_scope",
    "reasoning_mode",
    "output_schema_ref",
    "proposal_only",
    "repository_write_allowed",
    "manuscript_prose_allowed",
    "network_mode",
    "contains_secrets"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "series_id": {"type": ["string", "null"]},
    "book_id": {"type": ["string", "null"]},
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task": {"type": "string", "minLength": 1},
    "allowed_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_packet_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "private_content_scope": {
      "enum": ["NONE", "MINIMUM_NECESSARY", "OWNER_SELECTED"]
    },
    "reasoning_mode": {"enum": ["auto", "medium", "high", "xhigh"]},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "proposal_only": {"const": true},
    "repository_write_allowed": {"const": false},
    "manuscript_prose_allowed": {"const": false},
    "network_mode": {"enum": ["DISABLED", "SOURCE_PACKET_ONLY"]},
    "contains_secrets": {"const": false}
  },
  "additionalProperties": false
}