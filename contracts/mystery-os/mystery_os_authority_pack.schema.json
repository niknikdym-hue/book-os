{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-os.local/contracts/mystery-os/mystery_os_authority_pack.schema.json",
  "title": "MYSTERY OS Authority Pack",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "genre_profile",
    "story_definition",
    "case_solution",
    "case_timeline",
    "clues",
    "authority_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "series_id": {"type": ["string", "null"]},
    "book_id": {"type": ["string", "null"]},
    "authority_status": {
      "enum": ["DRAFT", "PROPOSED", "REVIEWED", "APPROVED", "LOCKED", "SUPERSEDED"]
    },
    "genre_profile": {
      "type": "object",
      "required": ["name", "primary_genre", "fair_play_mode", "supernatural_mode"],
      "properties": {
        "name": {"type": "string"},
        "primary_genre": {"type": "string"},
        "secondary_genres": {"type": "array", "items": {"type": "string"}},
        "fair_play_mode": {"enum": ["REQUIRED", "EXPECTED", "RELAXED"]},
        "supernatural_mode": {"enum": ["NONE", "AMBIGUOUS", "REAL"]},
        "tone": {"type": "string"},
        "reader_expectations": {"type": "array", "items": {"type": "string"}},
        "hard_exclusions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "story_definition": {
      "type": "object",
      "required": ["premise", "primary_mystery_question", "protagonist_engine", "stakes", "unique_angle"],
      "properties": {
        "premise": {"type": "string", "minLength": 1},
        "target_reader": {"type": "string"},
        "primary_mystery_question": {"type": "string", "minLength": 1},
        "secondary_mystery_questions": {"type": "array", "items": {"type": "string"}},
        "protagonist_engine": {"type": "string", "minLength": 1},
        "stakes": {"type": "string", "minLength": 1},
        "setting_function": {"type": "string"},
        "reality_contract": {"type": "string"},
        "unique_angle": {"type": "string", "minLength": 1},
        "target_characters_with_spaces": {"type": ["integer", "null"], "minimum": 1},
        "explicit_exclusions": {"type": "array", "items": {"type": "string"}},
        "anti_cliche_risks": {"type": "array", "items": {"type": "string"}},
        "commercial_hook": {"type": "string"}
      },
      "additionalProperties": true
    },
    "case_solution": {
      "type": "object",
      "required": ["incident", "responsible_actors", "actual_sequence", "motive", "means", "opportunity", "proof_chain"],
      "properties": {
        "incident": {"type": "string", "minLength": 1},
        "responsible_actors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "actual_sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "motive": {"type": "string", "minLength": 1},
        "means": {"type": "string", "minLength": 1},
        "opportunity": {"type": "string", "minLength": 1},
        "preparation": {"type": "array", "items": {"type": "string"}},
        "concealment": {"type": "array", "items": {"type": "string"}},
        "mistakes_and_traces": {"type": "array", "items": {"type": "string"}},
        "lies_and_secrets": {"type": "array", "items": {"type": "string"}},
        "proof_chain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "intentional_ambiguity": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "name", "role"],
        "properties": {
          "character_id": {"type": "string"},
          "name": {"type": "string"},
          "role": {"type": "string"},
          "external_goal": {"type": "string"},
          "internal_need": {"type": "string"},
          "fear": {"type": "string"},
          "competencies": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "secrets": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "suspects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "motive", "opportunity", "true_explanation"],
        "properties": {
          "character_id": {"type": "string"},
          "motive": {"type": "string"},
          "means": {"type": "string"},
          "opportunity": {"type": "string"},
          "alibi": {"type": "string"},
          "alibi_weaknesses": {"type": "array", "items": {"type": "string"}},
          "suspicious_behavior": {"type": "array", "items": {"type": "string"}},
          "true_explanation": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clue_id", "origin", "objective_meaning", "necessity", "first_appearance"],
        "properties": {
          "clue_id": {"type": "string"},
          "origin": {"type": "string"},
          "type": {"type": "string"},
          "objective_meaning": {"type": "string"},
          "necessity": {"enum": ["DECISIVE", "MATERIAL", "CORROBORATING", "OPTIONAL"]},
          "first_appearance": {"type": "string"},
          "reader_exposure": {"type": "string"},
          "interpretations": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "payoff": {"type": "string"},
          "fair_play_status": {"enum": ["UNASSESSED", "PASS", "FAIL"]}
        },
        "additionalProperties": true
      }
    },
    "red_herrings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["red_herring_id", "underlying_true_fact", "misleading_interpretation", "collapse_condition"],
        "properties": {
          "red_herring_id": {"type": "string"},
          "underlying_true_fact": {"type": "string"},
          "misleading_interpretation": {"type": "string"},
          "why_plausible": {"type": "string"},
          "collapse_condition": {"type": "string"},
          "cleanup_explanation": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "case_timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "time_ref", "event", "actors", "location"],
        "properties": {
          "event_id": {"type": "string"},
          "time_ref": {"type": "string"},
          "event": {"type": "string"},
          "actors": {"type": "array", "items": {"type": "string"}},
          "location": {"type": "string"},
          "uncertainty": {"type": "string"},
          "linked_clues": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "mystic_rule_set": {
      "type": ["object", "null"],
      "properties": {
        "phenomenon": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "triggers": {"type": "array", "items": {"type": "string"}},
        "costs": {"type": "array", "items": {"type": "string"}},
        "reliability": {"type": "string"},
        "physical_consequences": {"type": "array", "items": {"type": "string"}},
        "reader_disclosure_requirements": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "anti_cliche_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "finding"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["BLOCKING", "MAJOR", "MINOR", "NOTE"]},
          "finding": {"type": "string"},
          "location": {"type": "string"},
          "disposition": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "input_revision_refs": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
