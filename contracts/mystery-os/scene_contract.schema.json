{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-os.local/contracts/mystery-os/scene_contract.schema.json",
  "title": "MYSTERY OS Scene Contract",
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "viewpoint_character_id",
    "time_ref",
    "location_ref",
    "purpose",
    "entering_state_ref",
    "exiting_state_ref",
    "knowledge_state_ref",
    "state_change_codes",
    "tension_source"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "viewpoint_character_id": {"type": "string", "minLength": 1},
    "time_ref": {"type": "string", "minLength": 1},
    "location_ref": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "entering_state_ref": {"type": "string", "minLength": 1},
    "exiting_state_ref": {"type": "string", "minLength": 1},
    "knowledge_state_ref": {"type": "string", "minLength": 1},
    "state_change_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "mystery_question_refs": {"type": "array", "items": {"type": "string"}},
    "clue_operation_refs": {"type": "array", "items": {"type": "string"}},
    "reveal_operation_refs": {"type": "array", "items": {"type": "string"}},
    "suspect_hypothesis_movement": {"type": "array", "items": {"type": "string"}},
    "character_relationship_movement": {"type": "array", "items": {"type": "string"}},
    "tension_source": {"type": "string", "minLength": 1},
    "prohibited_disclosure_fact_ids": {"type": "array", "items": {"type": "string"}},
    "continuity_constraint_refs": {"type": "array", "items": {"type": "string"}},
    "required_authority_entity_ids": {"type": "array", "items": {"type": "string"}},
    "required_research_ids": {"type": "array", "items": {"type": "string"}},
    "anti_cliche_warning_codes": {"type": "array", "items": {"type": "string"}},
    "audio_listenability_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}