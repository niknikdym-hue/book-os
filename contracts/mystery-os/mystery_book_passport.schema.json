{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-os.local/contracts/mystery-os/mystery_book_passport.schema.json",
  "title": "MYSTERY OS Mystery Book Passport",
  "type": "object",
  "required": [
    "schema_version","book_id","book_number","working_title",
    "series_profile_id","series_profile_ref","premise_signature",
    "primary_case_type","victim_target_profile","culprit_relationship",
    "motive_family","mechanism","concealment","suspect_architecture",
    "clue_architecture","red_herring_pattern","supernatural_device",
    "setting_type","protagonist_jeopardy","emotional_conflict",
    "relationship_movement","midpoint_reversal","final_reveal",
    "climax_staging","ending_state","opening_pattern",
    "body_discovery_pattern","interview_cadence",
    "case_solution_architecture","prose_scene_pattern_risk",
    "assets_consumed","assets_reserved","reservation_claim_codes",
    "primary_case_resolved"
  ],
  "properties": {
    "schema_version":{"const":"0.1.0"},
    "book_id":{"type":"string","minLength":1},
    "book_number":{"type":"integer","minimum":1},
    "working_title":{"type":"string","minLength":1},
    "series_profile_id":{"type":"string","minLength":1},
    "series_profile_ref":{"type":"string","minLength":1},
    "premise_signature":{"type":"string","minLength":1},
    "primary_case_type":{"type":"string","minLength":1},
    "victim_target_profile":{"type":"string","minLength":1},
    "culprit_relationship":{"type":"string","minLength":1},
    "motive_family":{"type":"string","minLength":1},
    "mechanism":{"type":"string","minLength":1},
    "concealment":{"type":"string","minLength":1},
    "suspect_architecture":{"type":"string","minLength":1},
    "clue_architecture":{"type":"string","minLength":1},
    "red_herring_pattern":{"type":"string","minLength":1},
    "supernatural_device":{"type":"string"},
    "setting_type":{"type":"string","minLength":1},
    "protagonist_jeopardy":{"type":"string"},
    "emotional_conflict":{"type":"string","minLength":1},
    "relationship_movement":{"type":"string","minLength":1},
    "midpoint_reversal":{"type":"string","minLength":1},
    "final_reveal":{"type":"string","minLength":1},
    "climax_staging":{"type":"string","minLength":1},
    "ending_state":{"type":"string","minLength":1},
    "opening_pattern":{"type":"string","minLength":1},
    "body_discovery_pattern":{"type":"string","minLength":1},
    "interview_cadence":{"type":"string","minLength":1},
    "case_solution_architecture":{"type":"string","minLength":1},
    "prose_scene_pattern_risk":{"type":"string","minLength":1},
    "assets_consumed":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "assets_reserved":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "reservation_claim_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "primary_case_resolved":{"type":"boolean"},
    "late_entry_orientation_ref":{"type":["string","null"]}
  },
  "additionalProperties": false
}