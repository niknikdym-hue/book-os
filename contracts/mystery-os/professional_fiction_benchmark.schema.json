{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-os.local/contracts/mystery-os/professional_fiction_benchmark.schema.json",
  "title": "MYSTERY OS Professional Fiction Benchmark Run",
  "type": "object",
  "required": ["schema_version", "benchmark_set_id", "evaluated_revision_refs", "findings", "readiness_band"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "benchmark_set_id": {"type": "string", "minLength": 1},
    "evaluated_revision_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "checkpoint": {"enum": ["PRE_DRAFT", "REPRESENTATIVE_SAMPLE", "MIDBOOK", "WHOLE_BOOK", "FINAL"]},
    "readiness_band": {"enum": ["BELOW_PROFESSIONAL_FLOOR", "PROFESSIONAL_GAPS_REMAIN", "PROFESSIONAL_RANGE_CANDIDATE", "STRONG_PROFESSIONAL_CANDIDATE"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "severity", "observation", "recommended_action"],
        "properties": {
          "dimension": {"enum": ["PREMISE_IDENTITY", "NARRATIVE_ENGINE", "CHARACTERS", "SCENES", "DIALOGUE", "MYSTERY_CONSTRUCTION", "SUSPENSE", "PROSE_VOICE", "SETTING", "EMOTIONAL_ARCHITECTURE", "WHOLE_BOOK_STRUCTURE", "ORIGINALITY", "AUDIO_READINESS"]},
          "scope": {"type": ["string", "null"]},
          "severity": {"enum": ["BLOCKING", "MAJOR", "MINOR", "NOTE"]},
          "observation": {"type": "string", "minLength": 1},
          "manuscript_examples": {"type": "array", "items": {"type": "string"}},
          "non_infringing_comparison": {"type": ["string", "null"]},
          "recommended_action": {"type": "string", "minLength": 1},
          "human_disposition": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "evaluator_provenance": {"type": "array", "items": {"type": "string"}},
    "cost_provenance_refs": {"type": "array", "items": {"type": "string"}},
    "human_release_disposition": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}