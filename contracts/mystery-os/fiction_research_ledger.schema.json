{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-os.local/contracts/mystery-os/fiction_research_ledger.schema.json",
  "title": "MYSTERY OS Fiction Research Ledger",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["research_id", "question", "risk_class", "domain", "disposition"],
        "properties": {
          "research_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "risk_class": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
          "domain": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": ["string", "null"]},
          "time_period": {"type": ["string", "null"]},
          "assumed_answer": {"type": ["string", "null"]},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH"]},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "intentional_fictionalization": {"type": "boolean"},
          "fictionalization_rationale": {"type": ["string", "null"]},
          "dependent_authority_refs": {"type": "array", "items": {"type": "string"}},
          "freshness_horizon": {"type": ["string", "null"]},
          "disposition": {"enum": ["VERIFIED", "QUALIFIED", "FICTIONALIZED", "RESEARCH_NEEDED", "REJECTED"]},
          "expert_review": {"enum": ["NOT_NEEDED", "RECOMMENDED", "REQUIRED", "COMPLETED"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}